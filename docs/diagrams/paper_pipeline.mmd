flowchart LR
    DATA(["<b>AD Audit Logs</b><br/>1.8M events · 887 users"]):::terminal
    KG[("<b>Neo4j</b><br/>Knowledge Graph")]:::kg
    RULES["<b>Rule Engine</b><br/>10 domain rules"]:::proc
    FEAT["<b>Feature Extraction</b><br/>11 graph features"]:::proc

    subgraph ENS ["Ensemble · contamination 5%"]
        direction TB
        IF["Isolation Forest"]:::proc
        LOF["Local Outlier Factor"]:::proc
        EE["Elliptic Envelope"]:::proc
    end

    VOTE["<b>Majority Vote</b><br/>&ge; 2 of 3"]:::accent
    FUSE["<b>Score Fusion</b><br/>0.6&middot;ensemble + 0.4&middot;rule"]:::accent
    SHAP["<b>SHAP</b><br/>TreeExplainer"]:::proc
    SEV["<b>Severity</b><br/>quantile P75/P90/P95/P99"]:::proc
    EXPL["<b>Explainer · Phase 7</b><br/>KB-grounded + LLM"]:::proc
    REPORT(["<b>Anomaly Report</b><br/>ranked · explained · MITRE"]):::terminal

    DATA --> KG --> RULES --> FEAT
    FEAT --> IF
    FEAT --> LOF
    FEAT --> EE
    IF --> VOTE
    LOF --> VOTE
    EE --> VOTE
    VOTE --> FUSE
    RULES -. "rule_score" .-> FUSE
    FUSE --> SHAP --> SEV --> EXPL --> REPORT

    classDef terminal fill:#2b2b2b,stroke:#111111,color:#ffffff,font-weight:bold
    classDef kg fill:#e7f1ff,stroke:#0d6efd,stroke-width:2px,color:#0b2e6b
    classDef proc fill:#dbe7f5,stroke:#3a6ea5,color:#13314f
    classDef accent fill:#3f5168,stroke:#243447,color:#ffffff,font-weight:bold
    style ENS fill:#f8fafc,stroke:#cbd5e1,color:#334155
